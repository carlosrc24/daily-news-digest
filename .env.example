# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# --- Required ---------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gmail account that sends the digest, and its 16-character App Password
# (requires 2-Step Verification: https://myaccount.google.com/apppasswords)
EMAIL_SENDER=you@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop

# One or more recipients, comma-separated
EMAIL_RECEIVER=you@gmail.com

# --- Optional (defaults shown) ---------------------------------------------
# GEMINI_MODEL=gemini-3.8-flash
# Used if the primary model is overloaded or out of quota ("none" disables it)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Output language code for the analysis and email labels (en, es, fr, de, it, pt...)
# DIGEST_LANGUAGE=en
# LOOKBACK_HOURS=24
# ARTICLES_PER_CATEGORY=4
# CANDIDATES_PER_CATEGORY=12   # defaults to 3 x ARTICLES_PER_CATEGORY
# MAX_PER_FEED=8
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
