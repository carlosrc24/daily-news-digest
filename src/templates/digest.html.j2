<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ t.title }} · {{ date_str }}</title>
<style>
  /* Only progressive enhancements live here; everything essential is inlined. */
  @media only screen and (max-width: 620px) {
    .px { padding-left: 20px !important; padding-right: 20px !important; }
    .h1 { font-size: 26px !important; }
    .headline { font-size: 18px !important; }
  }
  a { color: #1f3a5f; }
</style>
</head>
<body style="margin:0; padding:0; background-color:#eeece6; -webkit-text-size-adjust:100%;">
{# Preheader: the preview line shown by inbox clients #}
<div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">
  {{ preheader }}
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eeece6;">
<tr><td align="center" style="padding:24px 12px;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; background-color:#ffffff; border:1px solid #dedbd2;">

  {# ---- Masthead ---- #}
  <tr><td class="px" style="padding:32px 40px 20px 40px; border-top:4px solid #1f3a5f;">
    <p style="margin:0 0 6px 0; font-family:Helvetica,Arial,sans-serif; font-size:12px; letter-spacing:1.5px; text-transform:uppercase; color:#6b6760;">{{ date_str }}</p>
    <h1 class="h1" style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:30px; line-height:1.2; font-weight:normal; color:#16181d;">{{ t.title }}</h1>
    <p style="margin:6px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#6b6760;">{{ t.subtitle }} &nbsp;·&nbsp; {{ stats }}</p>
  </td></tr>

  {# ---- Key points ---- #}
  {% if digest.key_points %}
  <tr><td class="px" style="padding:8px 40px 8px 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f6f4ee; border-left:3px solid #1f3a5f;">
      <tr><td style="padding:18px 22px;">
        <p style="margin:0 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:12px; font-weight:bold; letter-spacing:1.5px; text-transform:uppercase; color:#1f3a5f;">{{ t.key_points }}</p>
        {% for point in digest.key_points %}
        <p style="margin:0 0 {{ '0' if loop.last else '10px' }} 0; font-family:Georgia,'Times New Roman',serif; font-size:16px; line-height:1.55; color:#26282e; padding-left:16px; text-indent:-16px;">&#8226;&nbsp;&nbsp;{{ point }}</p>
        {% endfor %}
      </td></tr>
    </table>
  </td></tr>
  {% endif %}

  {# ---- Sections ---- #}
  {% for section in digest.sections %}
  <tr><td class="px" style="padding:30px 40px 0 40px;">
    <p style="margin:0; padding-bottom:8px; border-bottom:1px solid #16181d; font-family:Helvetica,Arial,sans-serif; font-size:13px; font-weight:bold; letter-spacing:1.5px; text-transform:uppercase; color:#16181d;">{{ category_label(section.category) }}</p>
  </td></tr>

  {% for item in section.items %}
  <tr><td class="px" style="padding:20px 40px {{ '4px' if loop.last else '20px' }} 40px;">
    <h2 class="headline" style="margin:0 0 6px 0; font-family:Georgia,'Times New Roman',serif; font-size:20px; line-height:1.3; font-weight:normal;">
      <a href="{{ item.link }}" style="color:#16181d; text-decoration:none;">{{ item.headline }}</a>
    </h2>
    <p style="margin:0 0 12px 0; font-family:Helvetica,Arial,sans-serif; font-size:12px; color:#8a857b;">{{ item.source }}{% if item.published %} &nbsp;·&nbsp; {{ item.published.strftime('%H:%M') }} UTC{% endif %}</p>

    {% for key, text in [('context', item.context), ('impact', item.impact), ('conclusion', item.conclusion)] %}
    <p style="margin:0 0 8px 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.6; color:#33363d;">
      <span style="font-size:11px; font-weight:bold; letter-spacing:1px; text-transform:uppercase; color:{{ '#1f3a5f' if key != 'conclusion' else '#8c5a1e' }};">{{ t[key] }}</span><br>
      {{ text }}
    </p>
    {% endfor %}

    <p style="margin:10px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:13px;">
      <a href="{{ item.link }}" style="color:#1f3a5f; font-weight:bold; text-decoration:none;">{{ t.read_more }} {{ item.source }} &rarr;</a>
    </p>
  </td></tr>
  {% if not loop.last %}
  {# Separator inside the padding so it aligns with the text column #}
  <tr><td class="px" style="padding:0 40px;"><div style="height:1px; line-height:1px; font-size:0; background-color:#e8e5dd;">&nbsp;</div></td></tr>
  {% endif %}
  {% endfor %}
  {% endfor %}

  {# ---- Footer ---- #}
  <tr><td class="px" style="padding:32px 40px 32px 40px;">
    {% if failed %}
    <p style="margin:0 0 12px 0; font-family:Helvetica,Arial,sans-serif; font-size:12px; color:#a0522d;">{{ t.failed }}: {{ failed | join(', ') }}</p>
    {% endif %}
    <p style="margin:0; padding-top:16px; border-top:1px solid #e8e5dd; font-family:Helvetica,Arial,sans-serif; font-size:12px; line-height:1.5; color:#8a857b;">{{ footer }}</p>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
